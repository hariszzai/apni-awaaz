# Copy this file to .env and fill in your keys. Never commit .env.

# From app.gnani.ai (API dashboard)
GNANI_API_KEY=

# Translation LLM: groq, gemini, or evon (self-hosted, OpenAI-compatible)
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=
# LLM_REASONING_EFFORT=low     (empty to not send it)

# Stock Timbre v3.0 voice used in Expressive mode
STOCK_VOICE=Shubham

# Signs the cloned voices kept in people's browsers. On a host, set a long random value
# and never change it, or everyone's saved voice stops working.
# Locally it can stay empty: a key is created in data/secret_key.
SECRET_KEY=

# Most Gnani API calls the demo makes per day (protects the 5,000 programme credits). 0 = no cap
GNANI_DAILY_LIMIT=1500

# Where previews and the local secret key are kept (default: ./data)
# DATA_DIR=
