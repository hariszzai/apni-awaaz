{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Apni Awaaz: laptop + phones (HTTPS)",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.server",
      "args": ["--https"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Apni Awaaz: laptop only (http)",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
